import SiteLayout from '../../layouts/SiteLayout.astro'; import { pageText as p, routes, TELEGRAM_URL } from '../../consts'; const t=p.uk;
---
<SiteLayout title={t.aboutTitle} description={t.aboutDescription} locale="uk" routeKey="about"><article class="prose"><p class="eyebrow">РЕДАКЦІЙНИЙ ПІДХІД</p><h1>Про проєкт Arsenal 7</h1><p class="lead">Arsenal 7 — незалежний гід із вибору спорядження та інструменту. Ми допомагаємо зрозуміти, що підходить для конкретної задачі, і не перетворюємо огляди на вітрину магазину.</p><h2>Як ми готуємо матеріали</h2><p>Ми збираємо характеристики з документації виробників, звіряємо відгуки власників та умови гарантії, порівнюємо пропозиції українських магазинів. Якщо ми особисто користувалися річчю, пишемо про це прямо. Якщо ні — зазначаємо, що спираємося на дані й досвід інших людей.</p><h2>Чого ми не публікуємо</h2><p>Ми не пишемо про зброю, боєприпаси та товари, для яких потрібні ліцензії чи дозволи. Не даємо інструкцій із самостійного ремонту там, де помилка небезпечна для здоров'я. Матеріали сайту не замінюють консультацію фахівця.</p><h2>Партнерські посилання</h2><p>Зараз на сайті немає реклами й партнерських посилань. Якщо вони з'являться, ми позначатимемо їх і пояснюватимемо зв'язок із матеріалом.</p><h2>Автор і зворотний зв'язок</h2><p>Автор: дані редактора потрібно підтвердити перед публікацією. {TELEGRAM_URL ? <>Запропонувати тему чи повідомити про помилку можна через <a href={TELEGRAM_URL}>Telegram</a>.</> : 'Контакт редакції потрібно додати перед публікацією.'} Ми виправляємо помилки й зазначаємо дату оновлення в матеріалі.</p><p class="related"><a href={routes.home.uk}>Головна</a><a href={routes.gear.uk}>Спорядження</a><a href={routes.tools.uk}>Інструмент</a></p></article></SiteLayout>
